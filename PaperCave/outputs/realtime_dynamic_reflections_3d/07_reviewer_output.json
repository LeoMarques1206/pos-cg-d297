    {
      "id": "abstract-card",
      "type": "card",
      "priority": "secondary",
      "title": "Paper Abstract: Problem & A...",
      "category": "abstract",
      "summary": "Summarizes challenges in real-time reflections and introduces a hybrid SSR/ra...",
      "contentType": "text_panel",
      "content": {
        "assetReference": null,
        "caption": null,
        "description": "Achieving realistic real-time dynamic reflections in 3D scenes with moving objects is crucial for accurate perception but challenging due to the computational cost of methods like ray tracing. Existing real-time solutions like Screen Space Reflections (SSR) have limitations (e.g., failure for occluded objects or those outside screen space), while cube maps lack physical accuracy. Prior hybrid approaches often only supported static objects or were too demanding for dynamic environments. This paper proposes a novel real-time hybrid algorithm that integrates SSR with pure GPU-ray tracing within a deferred rendering pipeline to overcome these limitations, targeting efficient and high-quality dynamic reflections.",
        "chartType": null,
        "title": null,
        "data": null
      },
      "conceptualOrigin": "Paper Abstract: Problem and Approach Summary",
      "whyThisUnit": "",
      "stackLabel": null,
      "items": null,
      "styleHint": {
        "categoryColor": "#E8F0FE",
        "colorName": "metallic white"
      }
