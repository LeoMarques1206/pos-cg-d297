    {
      "id": "unit_2",
      "type": "card",
      "priority": "secondary",
      "title": "Paper Abstract",
      "category": "abstract",
      "summary": "Overview of voice interaction challenges and potential in digital games and h...",
      "contentType": "text_panel",
      "content": {
        "assetReference": null,
        "caption": null,
        "description": "Voice interaction, despite its ubiquity in daily life, faces fluctuating integration in digital games due to technical limitations (e.g., microphone quality, transcription inaccuracies, ambient noise) and socio-behavioral issues (e.g., toxic player conduct, identity dissonance). This challenge is particularly acute in health-related games where voice interaction is scarce despite its potential for accessibility and rehabilitation. The paper addresses this by conducting a comparative study to understand diverse perceptions of voice interaction, leveraging advancements in AI and voice recognition to guide future game development, especially for enhancing immersion, engagement, and health applications.",
        "chartType": null,
        "title": null,
        "data": null
      },
